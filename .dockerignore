# Build output and dependencies are recreated inside the container
target/
node/
node_modules/
dist/
dev-dist/

# Git and editor files
.git/
.github/
.idea/
.vscode/

# R workspace files (large and not needed in the image)
src/main/r/.RData
src/main/r/.Rhistory
.Rproj.user/

# Never copy the local configuration into the image: it may contain
# passwords and Windows paths. Inside the container all settings come
# from docker-compose.yml and the .env file.
src/main/resources/application.properties
.env

*.log
