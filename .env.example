# Kopieren nach ".env" und eigene Werte eintragen. Die .env wird NICHT committet.

# Mindestens 64 Zeichen lang (HS512-Signatur der JWT-Tokens).
# Zufaelligen Wert erzeugen z. B. mit: openssl rand -hex 48
JWT_SECRET=hier-ein-langes-zufaelliges-geheimnis-mit-mindestens-vierundsechzig-zeichen-1234

# Optional: bestehende Datenbank statt der leeren lokalen MongoDB benutzen
# MONGODB_URI=mongodb+srv://USER:PASSWORT@cluster.example.mongodb.net/datenbank

# Optional: Ordner mit bisherigen Analyse-Ergebnissen einbinden
# ANALYSIS_DATA_DIR=C:/bioinformatics/data
