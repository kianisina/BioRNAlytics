# Copy to ".env" and fill in your own values. The .env file is NOT committed.

# At least 64 characters long (HS512 signature of the JWT tokens).
# Generate a random value e.g. with: openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-sixty-four-characters-1234567890

# Optional: use an existing database instead of the empty local MongoDB
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/database

# Optional: mount a folder containing earlier analysis results
# ANALYSIS_DATA_DIR=C:/bioinformatics/data
